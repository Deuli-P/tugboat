{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tugboat",
  "version": "0.3.4",
  "identifier": "com.pierre.tugboat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tugboat",
        "width": 1200,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEOEQyNkQwMjIxODU3MTQKUldRVVZ4Z2kwQ2FOTFNaTmRBV04yR0RyRUhCTGVuMmJ1cFlDaGR1WDNJOVhwWmxtQTZGR095MEsK",
      "endpoints": [
        "https://github.com/Deuli-P/tugboat-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
